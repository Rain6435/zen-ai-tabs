{
  "manifest_version": 3,
  "name": "Zen AI Tabs",
  "version": "1.0.0",
  "description": "BYOK AI tab grouping for Zen/Firefox. Sanitized, schema-validated, snapshot-backed undo.",
  "browser_specific_settings": {
    "gecko": {
      "id": "zen-ai-tabs@local.invalid",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["tabs", "tabGroups", "storage"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Zen AI Tabs",
    "default_popup": "src/ui/popup.html"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; connect-src 'self' https://generativelanguage.googleapis.com https://api.anthropic.com https://api.openai.com"
  }
}
